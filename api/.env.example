# Cloudflare D1（数据库）
# EdgeOne Makers 不提供托管 SQL 数据库，本项目通过 Cloudflare 的 D1 REST
# API 访问原有 D1 库，因此业务代码里的 SQL 无需改动。
# Token 权限需要包含 Account > D1 > Edit。
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=9b4c9d80-3cc1-4ad2-93e5-84281ed91e43
CF_API_TOKEN=

# EdgeOne Blob（上传文件）
BLOB_STORE_NAME=byt-cms-uploads
# 需改成 Blob 绑定公网域名后的访问地址，原值指向 R2 自定义域名，
# 迁移后 R2 不再托管新上传的文件。
FILE_URL=https://file.boycot.dpdns.org

# 第三方视频源抓取凭证
QUARK_API_KEY=
ALIYUN_REFRESH_TOKEN=
ALIYUN_CLIENT_ID=
ALIYUN_CLIENT_SECRET=
JIANGUOYUN_USERNAME=
JIANGUOYUN_APP_PASSWORD=

# 定时任务：POST /api/cron 的鉴权密钥（x-cron-secret 头），留空表示不校验
CRON_SECRET=
